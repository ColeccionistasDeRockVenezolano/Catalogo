# CRV · API del dominio (Fase 2B). Copiar a ~/apps/crv-landing/api.env (0600).
# Los secretos se generan con: openssl rand -hex 32
NODE_ENV=production
CRV_DEPLOYMENT=production
HOST=127.0.0.1
PORT=8083
CRV_COMMUNITY_ENABLED=true
# La portada no debe lanzar vigilante de Curaduría, retención ER ni refrescos.
CRV_BACKGROUND_JOBS=false
# Pinta la tarjeta de la portada. No emite ni escribe: lo público de /api/radio/*
# lo sigue atendiendo Herra a través del gateway.
CRV_RADIO_ENABLED=true
CRV_RADIO_DATA_DIR=/mnt/datos/crv-radio/catalogo
CRV_RADIO_LIVE_URL=http://127.0.0.1:3020/api/radio/now
# Corte de la radio (docs/independencia/FASE3.md §8): quitar CRV_RADIO_LIVE_URL y activar:
# CRV_RADIO_OWNER=true
# CRV_RADIO_STATE_DIR=/home/brian/apps/crv-landing/radio-estado
# CRV_RADIO_LOG_DIR=/home/brian/apps/crv-landing/logs
# Métricas (decisión de Brian, FASE2B §8). Si se encienden: true, un token propio
# aquí y el mismo token + CRV_TRAFFIC_REPORT=1 en crv-landing.env.
CRV_TRAFFIC_ENABLED=false
CRV_ALLOWED_ORIGINS=https://coleccionistasderockvenezolano.com
CRV_TRUST_CF_HEADERS=true
CRV_SESSION_COOKIE_PATH=/
CRV_VISITS_SECRET=__GENERAR_CON_OPENSSL_RAND_HEX_32__
CRV_CHAT_SECRET=__GENERAR_CON_OPENSSL_RAND_HEX_32__

CRV_RADIO_SHEET_CREDENTIALS=/home/brian/apps/crv-radio/secrets/service-account-radio-sheet.json
# Aviso de lanzamiento: permite a esta instancia vaciar la cola hacia Contactos.
CRV_LAUNCH_SHEET_CREDENTIALS=/home/brian/apps/crv-radio/secrets/service-account-radio-sheet.json
CRV_LAUNCH_SHEET_ID=1esSl_5HZeobiPYRA_1VrtiZtes81OeT4RSfkIqVSeEA
CRV_API_MODE=landing
