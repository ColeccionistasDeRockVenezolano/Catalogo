import {readFileSync,writeFileSync,existsSync} from 'node:fs';
import {closeDb} from '../../src/db/client.js';
import {withOperatorRun,createEntity,updateEntity,createRelation,deleteRelation} from '../../src/merge/operator.js';
import {createAlias} from '../../src/api/repositories/aliases.js';
const out=process.env['WAYBACK_OUT']!;if(!out)throw Error('WAYBACK_OUT obligatorio');
const before=JSON.parse(readFileSync(out+'/abismo-antes.json','utf8'));const file=out+'/abismo-identidad-corregida.json';
const archive=before.documents.find((d:any)=>Number(d.id)===16).archive_url;
const bolivarBio='Banda de heavy metal formada en Ciudad Bolívar, Venezuela, en noviembre de 2006 por Joan Nieves y Richard Barrios en las guitarras, Víctor Yánez en el bajo y Daniel Rodríguez en la batería. A finales de septiembre de 2007 se incorporó el vocalista Ronier Urbano. En 2008 grabó «Oscuro corazón» en Metnica Records, en Caracas. Tras la salida de Richard Barrios entró Ricardo Romero. El 16 de mayo de 2009 se presentó en el Soldiers Metal Fest de Ciudad Guayana y en diciembre de ese año participó en el compilado nacional Our War Begins.\n\nSu catálogo incluye el sencillo «Espíritu Inmortal» (2011) y «Abismo EP» (2012). La biografía publicada por la banda también describe la grabación de un EP llamado Espíritu Inmortal; la correspondencia entre esas ediciones requiere contrastar sus soportes originales. En marzo de 2011 Daniel Rodríguez fue sustituido por Miguelangel Gutiérrez, y desde abril de 2013 la banda ensayaba con Franklin Obregón en la batería.';
const meridaBio='Banda de rock de Mérida, Venezuela, documentada en el archivo de musica.com.ve de 2004. Su biografía describe una renovación del sonido mediante cambios de afinación y nuevos acordes; desde 2002 presentaba sus nuevas composiciones al público merideño. Sus integrantes estudiaban distintas carreras en la Universidad de los Andes y trabajaban, producían y grababan repetidamente cada tema hasta alcanzar el resultado buscado. El texto histórico describe el proyecto como «Abismo postmortem» y señala como motivos de sus canciones el sentimiento, el terror de la muerte y la tristeza del amor.\n\nLa formación documentada estaba integrada por Abraham Zamora en la voz, Daniel Alvarado en la guitarra, Carlos Porras en la batería y Raymi Landeo en el bajo. No se conoce el año de formación a partir de esta fuente.';
try{if(existsSync(file))throw Error('Corrección ya aplicada; verificar recibo');
 const result=await withOperatorRun({name:'wayback-cierre2:abismo-homonimos',operator:'codex (encargo de Brian)',note:'Separar Abismo de Mérida (fuente primaria archivada en 2004, integrantes ULA) de Abismo de Ciudad Bolívar (biografía propia: noviembre de 2006, integrantes y discos distintos). Rectificar la fusión errónea y conservar toda la evidencia.',params:{campaign:'wayback-finalizacion-2-2026-10-25',primarySources:[archive,'https://www.reverbnation.com/abismo']}},async ctx=>{
 await ctx.client.query("SELECT set_config('crv.run_id',$1,true)",[String(ctx.runId)]);
 const current=(await ctx.client.query('SELECT * FROM public.artists WHERE id=725 FOR UPDATE')).rows[0];if(current.biography!==before.artist[0].biography)throw Error('Cambió la ficha desde la línea base');
 const candidates=(await ctx.client.query("SELECT id FROM public.artists WHERE name ILIKE '%abismo%' AND id<>725")).rows;if(candidates.length)throw Error('Hay otros candidatos Abismo; revisar antes de crear');
 const created=await createEntity(ctx,'artist',{name:'Abismo (Mérida)',artist_type:'band',origin_city:'Mérida',origin_country:'Venezuela',biography:meridaBio,notes:'Identidad distinta de Abismo de Ciudad Bolívar (artista 725). Fuente primaria: '+archive+'. La actividad de 2002 no prueba el año de formación.'},{allowSimilar:true});const meridaId=created.id;
 await createAlias(ctx,'artist',meridaId,{alias:'Abismo',aliasType:'name_variant',isPrimary:false});
 await createAlias(ctx,'artist',725,{alias:'Abismo (Ciudad Bolívar)',aliasType:'name_variant',isPrimary:false});
 await updateEntity(ctx,'artist',725,{biography:bolivarBio,formed_year:2006,notes:'Identidad distinta de Abismo (Mérida), artista '+meridaId+'. Biografía propia contrastada: https://www.reverbnation.com/abismo. La atribución previa de la fuente merideña fue corregida conservando el historial. La clasificación y fechas de las ediciones existentes no se revisan por la sola separación de identidades.'});
 const memberships=(await ctx.client.query('SELECT * FROM public.artist_members WHERE artist_id=725 ORDER BY id FOR UPDATE')).rows;
 if(JSON.stringify(memberships.map((m:any)=>m.id))!==JSON.stringify(before.members.map((m:any)=>m.id)))throw Error('Cambió la formación');
 const moved:any[]=[];for(const m of memberships){let newMembership=null;
 // Carlos Porras fue emparejado sólo por nombre con un guitarrista de Amantium. Se conserva literalmente como baterista en documento y biografía, sin afirmar que sea esa persona.
 if(Number(m.person_id)!==14752)newMembership=await createRelation(ctx,'artist_membership',{artistId:meridaId,personId:Number(m.person_id)},{role:m.role,from_year:m.from_year,to_year:m.to_year,is_current:m.is_current,notes:m.notes});
 await deleteRelation(ctx,'artist_membership',Number(m.id));moved.push({previousMembershipId:Number(m.id),personId:Number(m.person_id),newMembershipId:newMembership?.id??null,status:newMembership?'reattributed':'identity-unresolved-name-only'});}
 const correction={campaign:'wayback-finalizacion-2-2026-10-25',runId:ctx.runId,previousArtistId:725,correctArtistId:meridaId,status:'resolved-distinct-bands',basis:'Ciudad, época, integrantes y repertorio incompatibles; dos fuentes primarias de los propios proyectos.',sources:[archive,'https://www.reverbnation.com/abismo'],unresolvedPersonLinks:[{name:'Carlos Porras',role:'Batería',rejectedPersonId:14752,reason:'El vínculo previo con el guitarrista de Amantium se basó sólo en el nombre; no se ha probado la identidad.'},{name:'Daniel Alvarado',role:'Guitarra',reason:'Se conserva el crédito literal; no se equipara a otros homónimos del catálogo.'}]};
 const docs=(await ctx.client.query('SELECT * FROM media.artist_documents WHERE artist_id=725 ORDER BY id FOR UPDATE')).rows;if(docs.length!==2||!docs.every((d:any)=>[16,17].includes(Number(d.id))))throw Error('Documentos inesperados');
 for(const d of docs){const isBio=Number(d.id)===16;await ctx.client.query('UPDATE media.artist_documents SET artist_id=$2,title=$3,content=$4,tags=$5,metadata=$6::jsonb,updated_at=now() WHERE id=$1',[d.id,isBio?meridaId:725,isBio?'Historia de Abismo (Mérida)':'Identidades diferenciadas — Abismo',isBio?d.content:d.content+'\n\nResolución de identidad\nLa ficha histórica corresponde a Abismo de Mérida, documentado en 2004 con Abraham Zamora, Daniel Alvarado, Carlos Porras y Raymi Landeo. Se ha separado como artista '+meridaId+'. La banda de Ciudad Bolívar se formó en noviembre de 2006 con otros integrantes, según su propia biografía en ReverbNation. No se trata de una mudanza documentada de la misma banda.\nhttps://www.reverbnation.com/abismo',[...new Set([...d.tags,'identidad-corregida','homonimos-diferenciados'])],JSON.stringify({...d.metadata,identityCorrection:correction})]);}
 const gallery=(await ctx.client.query('SELECT id FROM media.artist_gallery WHERE artist_id=725')).rows;const audiovisuals=(await ctx.client.query('SELECT id FROM media.artist_audiovisuals WHERE artist_id=725')).rows;const ephemerides=(await ctx.client.query('SELECT id FROM ingest.ephemerides WHERE original_artist_id=725')).rows;if(gallery.length||audiovisuals.length||ephemerides.length)throw Error('Aparecieron piezas que requieren atribución manual');
 return {artistId:725,newArtistId:meridaId,biographies:{725:bolivarBio,[meridaId]:meridaBio},documentIds:[16,17],sourceDocumentId:16,memberships:moved,albumsPreserved:before.albums.map((a:any)=>Number(a.id)),correction};
 });writeFileSync(file,JSON.stringify(result,null,2));console.log(JSON.stringify(result));
}finally{await closeDb();}
