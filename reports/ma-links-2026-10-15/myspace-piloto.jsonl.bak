{"ma_id": "40511", "banda": "Distrust", "crv_artist_id": "82", "slug": "distrust", "url": "https://myspace.com/distrust", "archivo_org": "", "ok": true, "snapshot_ts": "20091206111724", "url_snapshot": "https://web.archive.org/web/20091206111724id_/http://www.myspace.com:80/distrust", "fuente": "cdx", "bytes": 105824, "plantilla": "clasica", "titulo": "DISTRUST on MySpace Music - Free Streaming MP3s, Pictures & Music Downloads", "campos": {"Member Since": "4/13/2005", "Band Website": "www.myspace.com/distrust", "Band Members": "| \nFelipe \"ffepO\" Grüber - Guitars & Vocal\n | \n | \n \n | \nTomas \"tOmb\" Perez - Vocal\n | \n | \n \n | \nJorge \"Pepino\" Gonzalez - Drums\n | \n | \n \n | \nAndres Buitrago - Bass & Vocal", "Sounds Like": "A BIG TRUCK!!!", "Record Label": "Audioline Records", "About": "| \n\n \n \n \n \n \n \n \n \n\n \n\n \n \n | | \n\n FOLLOW US | \n\n | \n | \n | \n\n \n\n \nNEW SINGLE \"BEHOLD THE ZOMBIE NATION\"\n | \n | \n \n | \n | \n | \n \n | \n | \n \n \n \n \n \n \n \n |"}, "no_ascii": 12, "archivo": "data/raw/myspace-ma-2026-10-15/40511-20091206111724.html", "foto_url": "http://c4.ac-images.myspacecdn.com/images02/98/m_d616738d38ad4998a89e13cba43326cf.jpg"}
