{
  "manifest_version": 2,
  "name": "CRV puente RYM",
  "version": "4.6",
  "description": "Lee páginas de RYM con el Firefox real y las entrega al capturador por 127.0.0.1.",
  "browser_specific_settings": { "gecko": { "id": "crv-puente@local" } },
  "permissions": ["tabs", "storage", "webRequest", "webRequestBlocking", "<all_urls>", "http://127.0.0.1:8899/*"],
  "background": { "scripts": ["bg.js"], "persistent": true }
}
