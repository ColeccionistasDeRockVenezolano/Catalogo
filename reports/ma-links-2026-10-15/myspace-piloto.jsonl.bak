{"ma_id": "24284", "banda": "Tinieblas", "crv_artist_id": "757", "slug": "tinieblasven", "url": "http://myspace.com/tinieblasven", "archivo_org": "", "ok": true, "snapshot_ts": "20081009173143", "url_snapshot": "https://web.archive.org/web/20081009173143id_/http://www.myspace.com:80/tinieblasven", "fuente": "cdx", "bytes": 183494, "plantilla": "clasica", "titulo": "MySpace.com - TINIEBLAS - Caracas, VE - Thrash / Metal  - www.myspace.com/tinieblasven", "campos": {"Member Since": "2/7/2007", "Band Members": "| Christian Raster Guitarra y Voz | | \n | Hiram D´suze Bajo y Coros | | \n | Jose Avila Bateria", "Sounds Like": "| | | | | | | | | | |", "Record Label": "Independiente", "Type of Label": "Indie", "About": "| | La banda Venezolana Tinieblas informa: \n \n Se busca Guitarrista | \nCapas de comprometerse para trabajar duro favor comunicarse a través de los Telfs: | \n0414-3937409, 0412-2952031 y 0412-5928469 todos los dias | | \nPor favor solo verdaderos metaleros, si tu no reunes esta condición no te molestes en llamar | | \nChristian Raster \"Enlaces\" | www.theevilspiritrockers666.blogspot.com | www.tinieblasinfernales.tk | \n\n \nchristianraster@gmail.com \n\n \n \n \n \n \n \n |"}, "no_ascii": 30, "archivo": "data/raw/myspace-ma-2026-10-15/24284-20081009173143.html", "foto_url": "http://a958.ac-images.myspacecdn.com/images01/120/m_744374648e82dc731944073a0741f48d.jpg"}
{"ma_id": "25288", "banda": "Tierra del Dragón", "crv_artist_id": "688", "slug": "tierradeldragon", "url": "http://myspace.com/tierradeldragon", "archivo_org": "", "ok": true, "snapshot_ts": "20090131094743", "url_snapshot": "https://web.archive.org/web/20090131094743id_/http://www.myspace.com:80/tierradeldragon", "fuente": "cdx", "bytes": 150368, "plantilla": "clasica", "titulo": "TIERRA del DRAGON on MySpace Music - Free Streaming MP3s, Pictures & Music Downloads", "campos": {"Member Since": "9/4/2005", "Band Website": "network54.com/Forum/251810/", "Record Label": "Requalize"}, "no_ascii": 38, "archivo": "data/raw/myspace-ma-2026-10-15/25288-20090131094743.html", "foto_url": "http://c2.ac-images.myspacecdn.com/images01/9/m_cf99082aa17135a0bfaab4f28542576d.jpg"}
