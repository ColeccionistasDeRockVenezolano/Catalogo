import {writeFileSync,existsSync} from 'node:fs';
import {getPool,closeDb} from '../../src/db/client.js';
const out=process.env['WAYBACK_OUT']!;if(!out||existsSync(out+'/abismo-antes.json'))throw Error('Línea base existente o ruta ausente');
const p=getPool(),c=await p.connect();try{await c.query('BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY');const q=async(s:string,a:any[]=[]) =>(await c.query(s,a)).rows;
const result={at:new Date().toISOString(),candidates:await q("SELECT * FROM public.artists WHERE name ILIKE '%abismo%'"),aliases:await q("SELECT * FROM ingest.artist_aliases WHERE alias ILIKE '%abismo%'"),artist:await q('SELECT * FROM public.artists WHERE id=725'),albums:await q('SELECT * FROM public.albums WHERE artist_id=725 ORDER BY id'),members:await q('SELECT m.*,p.name person_name FROM public.artist_members m JOIN public.persons p ON p.id=m.person_id WHERE artist_id=725 ORDER BY m.id'),documents:await q('SELECT * FROM media.artist_documents WHERE artist_id=725 ORDER BY id'),gallery:await q('SELECT * FROM media.artist_gallery WHERE artist_id=725'),audiovisuals:await q('SELECT * FROM media.artist_audiovisuals WHERE artist_id=725'),ephemerides:await q('SELECT * FROM ingest.ephemerides WHERE original_artist_id=725'),memberJournal:await q("SELECT * FROM ingest.change_journal WHERE table_name='public.artist_members' AND (old_data->>'artist_id'='725' OR new_data->>'artist_id'='725') ORDER BY id")};
writeFileSync(out+'/abismo-antes.json',JSON.stringify(result,null,2));console.log(JSON.stringify(result,null,2));await c.query('COMMIT');}finally{c.release();await closeDb();}
