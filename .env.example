# CRV — variables de entorno (copiar a .env, nunca commitear .env real)

# --- Base de datos ---
# public = core canónico; el usuario de la app NO necesita permisos de
# escritura en public salvo el rol que use el merge engine.
# Coincide con docker-compose.yml (`npm run db:up`). Puerto 5433 para no
# chocar con otro PostgreSQL local en 5432.
DATABASE_URL=postgresql://crv:crv@127.0.0.1:5433/crv

# --- API ---
PORT=8080
HOST=127.0.0.1
# Bearer legado solo para automatizaciones internas. Déjalo vacío si todos
# los colaboradores usan el login web.
CRV_OPERATOR_TOKEN=
# Firma por defecto de las decisiones (se puede sobrescribir por petición con X-CRV-Operator).
CRV_OPERATOR_NAME=operador
# Cuentas de la interfaz. Solo hashes scrypt; el comando recomendado añade o
# rota una cuenta sin escribir su contraseña en el historial de la terminal:
# `npm run auth:set-collaborator -- usuario "Nombre visible"`.
CRV_COLLABORATORS_JSON=
# Login compartido con herra (coleccionistasderockvenezolano.com): ruta a su
# SQLite. Se abre en solo lectura; entran los usuarios aprobados del proyecto,
# sus administradores y el superadministrador, con la misma contraseña que en
# la web. Vacío = solo las cuentas del JSON anterior.
CRV_HERRA_DB_PATH=
CRV_HERRA_PROJECT_SLUG=coleccionistas-rock-venezolano
# Las sesiones viven en memoria del servidor y expiran aunque el navegador siga abierto.
CRV_SESSION_TTL_HOURS=12
# En producción bajo /crv limita la cookie a esa aplicación; en desarrollo directo se usa /.
CRV_SESSION_COOKIE_PATH=/
# Orígenes adicionales para desarrollo; el origen público servido por el mismo host se admite automáticamente.
CRV_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Curaduría: detector de conflictos ---
# Cada escritura de la API verifica al instante las fichas que tocó (análisis
# dirigido) y el análisis completo queda diferido. El vigilante cubre cambios
# hechos fuera de la API (CLI, scripts); 0 lo apaga.
CRV_CURATION_AUTOSCAN=true
CRV_CURATION_WATCH_MS=60000
# Análisis completo diferido: cuánto silencio de escrituras espera y cuánto
# como máximo desde la primera escritura sin analizar.
CRV_CURATION_FULL_SCAN_IDLE_MS=30000
CRV_CURATION_FULL_SCAN_MAX_WAIT_MS=600000
# Lotes de correcciones: ítems que aplica o deshace cada llamada (el resto
# continúa con otra llamada) y hallazgos máximos en una vista previa.
CRV_CURATION_FIX_BATCH_MAX=500
CRV_CURATION_FIX_PREVIEW_MAX=5000
# Autocorrección segura: apagada por defecto. Encendida, solo aplica acciones
# de nivel 0 de las reglas que un administrador haya activado, con estos topes.
CRV_CURATION_AUTOFIX=false
CRV_CURATION_AUTOFIX_MAX_PER_SCAN=50
CRV_CURATION_AUTOFIX_MAX_PER_DAY=200

# Géneros: con true, albums.genre es la proyección de ingest.album_genres y el
# motor de fusión deja de escribirlo. Encender tras `crv genres backfill --confirm`.
GENRES_PROJECTION_ENABLED=false

# Géneros, fuentes externas (etapa 4). Apagado no sale nada a la red; además
# cada fuente necesita su ficha autorizada (`crv genres external sources`).
# El contacto va en el User-Agent: MusicBrainz y Discogs bloquean las
# peticiones con un User-Agent genérico o sin vía de contacto.
GENRES_EXTERNAL_ENABLED=false
#GENRES_EXTERNAL_CONTACT=correo-o-url-de-contacto
# Token personal de la API de Discogs (nunca se commitea; va en .env).
# Viaja en la cabecera Authorization, jamás en la URL.
#DISCOGS_TOKEN=
# Clave de la API de Last.fm (scripts/harvest-lastfm-genres.py; nunca se
# commitea). Se crea gratis en https://www.last.fm/api/account/create.
#LASTFM_API_KEY=
GENRES_EXTERNAL_CACHE_TTL_DAYS=30
GENRES_EXTERNAL_MAX_ENTITIES=200
GENRES_EXTERNAL_MATCH_THRESHOLD=0.6
GENRES_EXTERNAL_AMBIGUOUS_THRESHOLD=0.6
GENRES_EXTERNAL_MATCH_MARGIN=0.08

# --- Almacenamiento crudo ---
DATA_DIR=./data

# --- Fetcher / crawling ---
CRAWL_USER_AGENT=CRV-bot/0.1 (+contacto: definir)
CRAWL_TIMEOUT_MS=15000
CRAWL_DELAY_MS=1000
CRAWL_MAX_RETRIES=3
CRAWL_CACHE_TTL_DAYS=7

# --- YouTube Data API (F3; opcional — sin ella el sistema funciona igual) ---
YOUTUBE_API_KEY=
# Presupuesto diario en unidades de cuota (YouTube concede 10.000). `yt:enrich-artist`
# no busca si lo gastado hoy no deja margen para una search.list (100 unidades).
YOUTUBE_DAILY_QUOTA_UNITS=10000

# --- DeepSeek (F6; opcional — sin ella el sistema funciona igual, solo rutas deterministas) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# IDs configurables: el codigo selecciona por rol fast/reasoning/vision, no
# compara ni acopla logica a un nombre concreto de modelo.
DEEPSEEK_MODEL_FAST=deepseek-flash
DEEPSEEK_MODEL_REASONING=deepseek-v4-pro
DEEPSEEK_MODEL_VISION=deepseek-flash
DEEPSEEK_MAX_TOKENS_PER_RUN=4000
DEEPSEEK_TIMEOUT_MS=30000
# Propuestas de curaduría: V4.1 Flash usa deepseek-flash en la API oficial.
# Guardar, validar e implementar una propuesta no llama al modelo.
CRV_AI_CURATION_MODEL=deepseek-flash
CRV_AI_CURATION_MAX_TOKENS=6000
CRV_AI_CURATION_MAX_CALLS=2
CRV_AI_CURATION_CONTEXT_CHARS=40000
# Perfiles por API en la petición general de un artista: la discografía la
# compara el código (MusicBrainz, Discogs, Deezer/iTunes); el modelo no la lee.
# Necesita GENRES_EXTERNAL_CONTACT y DISCOGS_TOKEN.
CRV_SOURCE_PROFILES_ENABLED=false
CRV_SEARXNG_URL=
CRV_SEARXNG_SECRET=
# Presupuesto acumulado de investigación; reanudar permite ampliar el límite por API.
CRV_RESEARCH_MAX_CALLS=200
# Optional shared, persisted financial/call/token budget, created with ai:budget.
# CRV_AI_BUDGET_ID=stage2-acceptance
CRV_RESEARCH_MAX_TOKENS=1000000
# Propiedad de trabajos: el heartbeat renueva la lease mientras el proceso sigue activo.
CRV_RESEARCH_LEASE_SECONDS=180
# Documentos: límites por adquisición/lectura; un límite deja pendientes recuperables.
CRV_RESEARCH_DOCUMENT_MAX_BYTES=25000000
CRV_RESEARCH_DOCUMENT_MAX_PAGES=100
CRV_RESEARCH_DOCUMENT_TIMEOUT_MS=120000
CRV_RESEARCH_MIN_FREE_MB=256
CRV_RESEARCH_RENDER_ENABLED=true
CRV_RESEARCH_RENDER_TIMEOUT_MS=20000
CRV_RESEARCH_OCR_LANGUAGES=spa+eng
# Opcional: directorio/URL de archivos <idioma>.traineddata.gz para operación sin descargas.
# CRV_RESEARCH_OCR_LANG_PATH=
CRV_RESEARCH_PDF_TEXT_COMMAND=pdftotext
CRV_RESEARCH_PDF_RENDER_COMMAND=pdftoppm
CRV_RESEARCH_PDF_IMAGES_COMMAND=pdfimages
CRV_RESEARCH_PDF_INFO_COMMAND=pdfinfo
CRV_RESEARCH_PDF_RASTER_SIZE=3200
CRV_WEB_SEARCH_CACHE_DAYS=30
CRV_WEB_PAGE_CACHE_DAYS=30

# --- Entity resolution (0..1; orden estricto) ---
ER_AUTO_MATCH_THRESHOLD=0.90
ER_POSSIBLE_MATCH_THRESHOLD=0.72
ER_REVIEW_THRESHOLD=0.50
ER_NO_MATCH_THRESHOLD=0.00
ER_MINIMUM_MARGIN=0.08
# Retención de decisiones de resolución: días de dossier completo de candidatas
# que se conservan antes de compactarlo (la decisión nunca se borra: se queda
# con sus features, su explanation y las 20 mejores candidatas), tope de filas
# por barrido de la API y cada cuánto barre.
ER_DECISION_FULL_DAYS=3
ER_RETENTION_MAX_ROWS=20000
ER_RETENTION_INTERVAL_HOURS=12

# --- Logs ---
LOG_LEVEL=info

# Descubrimiento editorial (fase 1). Activar tras migración y curaduría.
CRV_DISCOVERY_ENABLED=false
CRV_DISCOVERY_INTERVAL_MS=5000
CRV_DISCOVERY_GROUP_POLICY=historicos,alternativo,contemporaneos,experimental

# Analítica propia del buscador (0053); apagada hasta activación controlada.
CRV_DISCOVERY_METRICS_ENABLED=false
# Generar un secreto independiente (mínimo 32 caracteres); nunca enviarlo a la SPA.
# CRV_DISCOVERY_METRICS_SECRET=
# Recomendación etapa 4: API interna; activar tras 0056 y evaluación revisada.
CRV_RECOMMENDATIONS_ENABLED=false
CRV_RECOMMENDATION_PROVIDER=disabled
CRV_RECOMMENDATION_BASE_URL=http://127.0.0.1:8000/
CRV_RECOMMENDATION_MODEL=multilingual
# Para Jev: PROVIDER=jev, BASE_URL=https://api.typesafe.ai/, MODEL=jev-latest.
# CRV_RECOMMENDATION_API_KEY=
CRV_RECOMMENDATION_THRESHOLD=0.8
CRV_RECOMMENDATION_TIMEOUT_MS=10000

# E2: intérprete local del SDK Laya para propuestas de evidencia; no es un servicio público.
CRV_LAYA_PYTHON=/home/brian/.venvs/laya/bin/python

# Retención del chat: conserva mensajes con reportes pendientes.
CRV_CHAT_MESSAGE_RETENTION_DAYS=90
