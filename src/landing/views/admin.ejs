                <div class="theme-field">
                  <label class="field-label" for="brand-donation-label"><%= t('admin.brandDonationLabel') %></label>
                  <input type="text" id="brand-donation-label" data-donation-field="label" maxlength="120" value="<%= branding.donation.label %>" placeholder="<%= brandingDefaults.donation.label %>">
