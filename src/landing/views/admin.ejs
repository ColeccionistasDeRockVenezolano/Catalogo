    <dialog class="modal modal--sm admin-dialog" id="accessCodeDialog" aria-labelledby="access-code-title">
      <div class="modal__panel">
        <div class="modal__head">
          <div class="modal__titles">
            <span class="kicker"><%= t('admin.securityKicker') %></span>
            <h2 class="modal__title" id="access-code-title"><%= t('admin.resetCodeTitle') %></h2>
            <p class="modal__sub"><%= t('admin.resetCodeSub') %></p>
          </div>
          <button type="button" class="modal__close" data-close-access-code aria-label="<%= t('common.close') %>"><i data-lucide="x"></i></button>
        </div>
        <div class="modal__body">
          <form id="accessCodeForm">
            <input type="hidden" name="userId">
            <div class="field">
              <label for="reset-access-code"><%= t('admin.resetCodeNew') %></label>
              <input type="password" id="reset-access-code" name="accessCode" minlength="8" maxlength="200" autocomplete="new-password" required>
            </div>
            <div class="field">
              <label for="reset-access-code-confirm"><%= t('admin.resetCodeRepeat') %></label>
              <input type="password" id="reset-access-code-confirm" name="accessCodeConfirm" minlength="8" maxlength="200" autocomplete="new-password" required>
            </div>
            <div class="form-actions modal__actions">
              <button type="submit" class="btn btn-red btn-sm"><%= t('admin.resetCodeSave') %></button>
              <button type="button" class="btn btn-ghost btn-sm" data-close-access-code><%= t('common.cancel') %></button>
            </div>
          </form>
        </div>
      </div>
    </dialog>

    <%
      // Idiomas del proyecto. Herra ya viene traducida: lo que se escribe aquí
      // son los textos propios del proyecto en el otro idioma. El campo vacío
      // no es un hueco publicado — se sirve el español, que es el original.
      //
      // Tres pestañas, tres orígenes distintos de texto: la identidad del
      // proyecto, lo que personalizó del formulario público y el contenido del
      // roadmap que escribe cada día.
      const languageNames = { en: t('admin.langEnglish') };
      const langSourceOf = (key) => {
        const source = projectI18nSource[key];
        return source ? String(source).replace(/<br>/g, ' / ').replace(/\n/g, ' / ') : '—';
      };
    %>
    <dialog class="modal modal--lg" id="languages-form" data-modal-root aria-labelledby="languages-title">
      <div class="modal__panel">
        <div class="modal__head">
          <div class="modal__titles">
            <span class="kicker"><%= t('admin.langKicker') %></span>
            <h2 class="modal__title" id="languages-title"><%= t('admin.languages') %></h2>
            <p class="modal__sub"><%= t('admin.langSub') %></p>
          </div>
          <button type="button" class="modal__close" data-modal-close aria-label="<%= t('common.close') %>"><i data-lucide="x"></i></button>
        </div>
        <div class="modal__toolbar">
          <div class="cfg-tabs" role="tablist" aria-label="<%= t('admin.langSectionsAria') %>">
            <button type="button" class="cfg-tab is-current" role="tab" aria-selected="true" aria-controls="lang-project" data-lang-tab="lang-project"><%= t('admin.langTabProject') %></button>
            <button type="button" class="cfg-tab" role="tab" aria-selected="false" aria-controls="lang-form" data-lang-tab="lang-form"><%= t('admin.langTabForm') %></button>
            <button type="button" class="cfg-tab" role="tab" aria-selected="false" aria-controls="lang-content" data-lang-tab="lang-content"><%= t('admin.langTabContent') %></button>
          </div>
        </div>
        <div class="modal__body">
          <form id="languagesForm">
            <section class="cfg-pane" id="lang-project" role="tabpanel" aria-labelledby="lang-project-title">
              <div class="settings-segment__head">
                <h3 id="lang-project-title" class="theme-subhead"><%= t('admin.langProjectTitle') %></h3>
                <p class="field-help"><%= t('admin.langProjectHelp') %></p>
              </div>
              <% projectI18nLangs.forEach(function (code) { %>
              <% const values = projectI18n[code] || {}; %>
              <fieldset class="lang-fieldset" data-lang-group="<%= code %>">
                <legend><%= languageNames[code] || code.toUpperCase() %></legend>
                <div class="field-grid field-grid--halves">
                  <% projectI18nFields.forEach(function (field) { %>
                  <div class="field<%= field.multiline ? ' field--full' : '' %>">
                    <label for="i18n-<%= code %>-<%= field.key %>"><%= field.labelText || t(field.labelKey) %></label>
                    <% if (field.multiline) { %>
                    <textarea id="i18n-<%= code %>-<%= field.key %>" data-i18n-field="<%= field.key %>" rows="3" maxlength="<%= field.maxLength %>" placeholder="<%= projectI18nSource[field.key] || '' %>"><%= values[field.key] || '' %></textarea>
                    <% } else { %>
                    <input type="text" id="i18n-<%= code %>-<%= field.key %>" data-i18n-field="<%= field.key %>" maxlength="<%= field.maxLength %>" placeholder="<%= projectI18nSource[field.key] || '' %>" value="<%= values[field.key] || '' %>">
                    <% } %>
                    <small class="field-help"><%= t('admin.langSpanishIs', { text: langSourceOf(field.key) }) %></small>
                  </div>
                  <% }) %>
                </div>
                <% if (projectI18nSocialFields.length > 0) { %>
                <div class="field-grid field-grid--halves">
                  <% projectI18nSocialFields.forEach(function (field) { %>
                  <div class="field">
                    <label for="i18n-<%= code %>-<%= field.key %>"><%= field.labelText || t(field.labelKey) %></label>
                    <input type="text" id="i18n-<%= code %>-<%= field.key %>" data-i18n-field="<%= field.key %>" maxlength="<%= field.maxLength %>" placeholder="<%= projectI18nSource[field.key] || '' %>" value="<%= values[field.key] || '' %>">
                    <small class="field-help"><%= t('admin.langSpanishIs', { text: langSourceOf(field.key) }) %></small>
                  </div>
                  <% }) %>
                </div>
                <% } %>
              </fieldset>
              <% }) %>
            </section>

            <section class="cfg-pane" id="lang-form" role="tabpanel" aria-labelledby="lang-form-title" hidden>
              <div class="settings-segment__head">
                <h3 id="lang-form-title" class="theme-subhead"><%= t('admin.langFormTitle') %></h3>
                <p class="field-help"><%= t('admin.langFormHelp') %></p>
              </div>
              <% if (projectI18nCollabFields.length === 0) { %>
              <p class="admin-notice"><%= t('admin.langFormNone') %> <button type="button" class="linklike" data-open="collaborate-form-config"><%= t('admin.collaborateForm') %></button>.</p>
              <% } else { %>
              <% projectI18nLangs.forEach(function (code) { %>
              <% const values = projectI18n[code] || {}; %>
              <fieldset class="lang-fieldset" data-lang-group="<%= code %>">
                <legend><%= languageNames[code] || code.toUpperCase() %></legend>
                <div class="field-grid field-grid--halves">
                  <% projectI18nCollabFields.forEach(function (field) { %>
                  <div class="field<%= field.multiline ? ' field--full' : '' %>">
                    <label for="i18n-<%= code %>-<%= field.key %>"><%= field.labelText || t(field.labelKey) %></label>
                    <% if (field.multiline) { %>
                    <textarea id="i18n-<%= code %>-<%= field.key %>" data-i18n-field="<%= field.key %>" rows="3" maxlength="<%= field.maxLength %>" placeholder="<%= projectI18nSource[field.key] || '' %>"><%= values[field.key] || '' %></textarea>
                    <% } else { %>
                    <input type="text" id="i18n-<%= code %>-<%= field.key %>" data-i18n-field="<%= field.key %>" maxlength="<%= field.maxLength %>" placeholder="<%= projectI18nSource[field.key] || '' %>" value="<%= values[field.key] || '' %>">
                    <% } %>
                    <small class="field-help"><%= t('admin.langSpanishIs', { text: langSourceOf(field.key) }) %></small>
                  </div>
                  <% }) %>
                </div>
              </fieldset>
              <% }) %>
              <% } %>
            </section>

            <p class="admin-status" id="languagesStatus" role="status" aria-live="polite"></p>
            <div class="form-actions modal__actions">
              <button type="submit" class="btn btn-red btn-sm"><%= t('admin.langSave') %></button>
              <button type="button" class="btn btn-ghost btn-sm" data-languages-reset><%= t('admin.langReset') %></button>
              <button type="button" class="btn btn-ghost btn-sm" data-modal-close><%= t('common.cancel') %></button>
            </div>
          </form>

          <!-- ---- Contenido del roadmap -------------------------------------
               Las etapas y actividades no viven en el JSON del proyecto sino en
               su propia fila, así que tienen su formulario y su guardado. Van
               todas en una lista para poder traducirlas de una sentada. -->
          <form id="contentI18nForm" hidden>
            <section class="cfg-pane" id="lang-content" role="tabpanel" aria-labelledby="lang-content-title">
              <div class="settings-segment__head">
                <h3 id="lang-content-title" class="theme-subhead"><%= t('admin.langContentTitle') %></h3>
                <p class="field-help"><%= t('admin.langContentHelp') %></p>
              </div>
              <% projectI18nLangs.forEach(function (code) { %>
              <fieldset class="lang-fieldset" data-content-lang="<%= code %>">
                <legend><%= languageNames[code] || code.toUpperCase() %></legend>
                <% if (contentStages.length === 0) { %>
                <p class="admin-notice"><%= t('admin.langContentEmpty') %></p>
                <% } %>
                <% contentStages.forEach(function (stage, stageIndex) { %>
                <div class="cfg-group lang-stage">
                  <h4 class="cfg-group__title"><%= phaseLabel(stageIndex, lang) %> · <%= stage.title %></h4>
                  <div class="field">
                    <label for="content-i18n-<%= code %>-stage-<%= stage.id %>"><%= t('admin.langStageTitle') %></label>
                    <input type="text" id="content-i18n-<%= code %>-stage-<%= stage.id %>"
                           data-content-kind="categories" data-content-id="<%= stage.id %>"
                           maxlength="300" placeholder="<%= stage.title %>"
                           value="<%= stage.translations[code] || '' %>">
                    <small class="field-help"><%= t('admin.langSpanishIs', { text: stage.title }) %></small>
                  </div>
                  <% if (stage.tasks.length === 0) { %>
                  <p class="field-help"><%= t('admin.langStageNoTasks') %></p>
                  <% } %>
                  <% stage.tasks.forEach(function (task) { %>
                  <div class="field">
                    <label for="content-i18n-<%= code %>-task-<%= task.id %>"><%= task.title %></label>
                    <input type="text" id="content-i18n-<%= code %>-task-<%= task.id %>"
                           data-content-kind="tasks" data-content-id="<%= task.id %>"
                           maxlength="300" placeholder="<%= task.title %>"
                           value="<%= task.translations[code] || '' %>">
                  </div>
                  <% }) %>
                </div>
                <% }) %>
              </fieldset>
              <% }) %>
            </section>
            <p class="admin-status" id="contentI18nStatus" role="status" aria-live="polite"></p>
            <div class="form-actions modal__actions">
              <button type="submit" class="btn btn-red btn-sm"><%= t('admin.langSave') %></button>
              <button type="button" class="btn btn-ghost btn-sm" data-content-i18n-reset><%= t('admin.langReset') %></button>
              <button type="button" class="btn btn-ghost btn-sm" data-modal-close><%= t('common.cancel') %></button>
            </div>
          </form>
        </div>
      </div>
    </dialog>

    <dialog class="modal modal--lg" id="new-task-form" data-modal-root aria-labelledby="new-task-title">
      <div class="modal__panel">
        <div class="modal__head">
          <div class="modal__titles">
            <span class="kicker"><%= t('admin.newTaskKicker') %></span>
            <h2 class="modal__title" id="new-task-title"><%= t('admin.newTaskTitle') %></h2>
          </div>
          <button type="button" class="modal__close" data-modal-close aria-label="<%= t('common.close') %>"><i data-lucide="x"></i></button>
        </div>
        <div class="modal__body">
          <form method="post" action="/api/community/admin/panel/tasks" class="new-task-form" id="createForm">
            <div class="field">
              <label for="nt-title"><%= t('admin.taskLabel') %></label>
              <input type="text" id="nt-title" name="title" maxlength="300" placeholder="<%= t('admin.taskPlaceholder') %>" required>
            </div>
            <% projectI18nLangs.forEach(function (code) { %>
            <div class="field">
              <label for="nt-title-<%= code %>"><%= t('admin.langTaskEnglish') %></label>
              <input type="text" id="nt-title-<%= code %>" data-new-translation="<%= code %>" maxlength="300">
              <small class="field-help"><%= t('admin.langTaskEnglishHelp') %></small>
            </div>
            <% }) %>
            <div class="field-row">
              <div class="field">
                <label for="nt-category"><%= t('admin.taskCategory') %></label>
                <select id="nt-category" name="categoryId" required>
                  <% view.categories.forEach(function(c) { %>
                  <option value="<%= c.id %>"><%= c.title %></option>
                  <% }) %>
                </select>
              </div>
              <div class="field">
                <label for="nt-status"><%= t('admin.taskStatus') %></label>
                <select id="nt-status" name="status">
                  <option value="pending"><%= t('status.pending') %></option>
                  <option value="in_progress"><%= t('status.in_progress') %></option>
                  <option value="completed"><%= t('status.completed') %></option>
                </select>
              </div>
              <div class="field">
                <label for="nt-position"><%= t('admin.taskPosition') %></label>
                <input type="number" id="nt-position" name="position" min="1" step="1" placeholder="<%= t('admin.taskPositionPlaceholder') %>">
              </div>
              <div class="field field--wide">
                <span class="field-label" id="nt-assigned-label"><%= t('admin.taskAssignTo') %></span>
                <div class="assignee-picker" data-assignee-picker>
                  <div class="assignee-search">
                    <input type="text" class="assignee-search-input" data-assignee-search placeholder="<%= t('admin.taskSearchPeople') %>" autocomplete="off" role="combobox" aria-expanded="false" aria-autocomplete="list" aria-labelledby="nt-assigned-label">
                    <div class="assignee-results" data-assignee-results hidden></div>
                  </div>
                  <div class="assignee-chips" data-assignee-chips></div>
                  <div class="visually-hidden" id="nt-assigned-users" data-assignment-group aria-hidden="true">
                    <% availableUsers.forEach(function(user) { %>
                    <label for="assign-new-<%= user.id %>">
                      <input type="checkbox" id="assign-new-<%= user.id %>" name="assignedUserIds" value="<%= user.id %>" data-assignment-checkbox tabindex="-1">
                      <span><%= displayName(user) %></span>
                    </label>
                    <% }) %>
                  </div>
                </div>
              </div>
            </div>
            <div class="form-actions modal__actions">
              <button type="submit" class="btn btn-red btn-sm"><%= t('common.create') %></button>
              <button type="button" class="btn btn-ghost btn-sm" data-close="new-task-form"><%= t('common.cancel') %></button>
            </div>
          </form>
        </div>
      </div>
    </dialog>

    <div class="task-reorder-help" id="task-drag-help">
      <span class="task-reorder-help__icon"><i data-lucide="grip-vertical"></i></span>
      <p><%- t('admin.reorderHelp') %></p>
    </div>
    <div class="task-reorder-help" id="task-queue-help">
      <span class="task-reorder-help__icon"><i data-lucide="pin"></i></span>
      <p><%- t('admin.queueRule') %></p>
    </div>
    <p class="admin-status" id="adminStatus" role="status" aria-live="polite"></p>

    <div class="cat-list" data-cat-dropzone>
    <% view.categories.forEach(function(cat, catIdx) { %>
    <div class="cat-block" data-cat-slug="<%= cat.slug %>" data-category-id="<%= cat.id %>">
      <div class="section-head section-head--reorderable">
        <button type="button" class="cat-drag-handle" data-cat-drag-handle aria-label="<%= t('admin.reorderStageAria', { stage: cat.title }) %>" aria-describedby="task-drag-help" title="<%= t('admin.dragToReorder') %>">
          <i data-lucide="grip-vertical"></i><span class="visually-hidden"><%= t('admin.reorderStage') %></span>
        </button>
        <div class="cat-head-main">
          <span class="kicker kicker--<%= cat.colorKey %>" data-cat-kicker><%= phaseLabel(catIdx, lang) %></span>
          <div class="cat-title-row" data-cat-title-view>
            <h2 class="cat-title"><%= cat.title %></h2>
            <button type="button" class="ctl ctl-btn category-edit" data-action="category-edit-toggle" data-id="<%= cat.id %>" aria-label="<%= t('admin.editStageAction') %>"><i data-lucide="pencil"></i></button>
            <button type="button" class="ctl ctl-btn ctl-danger" data-action="category-delete" data-id="<%= cat.id %>" aria-label="<%= t('admin.deleteStage') %>"><i data-lucide="trash-2"></i></button>
          </div>
          <dialog class="modal modal--sm" data-cat-title-edit aria-label="<%= t('admin.editStageTitleAria', { stage: cat.title }) %>">
            <div class="modal__panel">
              <div class="modal__head">
                <div class="modal__titles">
                  <span class="kicker kicker--<%= cat.colorKey %>" data-cat-kicker><%= phaseLabel(catIdx, lang).toUpperCase() %></span>
                  <h2 class="modal__title"><%= t('admin.editStageTitle') %></h2>
                </div>
                <button type="button" class="modal__close" data-modal-close aria-label="<%= t('common.close') %>"><i data-lucide="x"></i></button>
              </div>
              <div class="modal__body">
                <div class="field">
                  <label for="cat-title-input-<%= cat.id %>"><%= t('admin.editStageLabel') %></label>
                  <input type="text" id="cat-title-input-<%= cat.id %>" class="cat-title-input" data-cat-title-input data-id="<%= cat.id %>" value="<%= cat.title %>" maxlength="300">
                </div>
                <div class="form-actions modal__actions">
                  <button type="button" class="btn btn-red btn-sm" data-action="category-save" data-id="<%= cat.id %>"><%= t('common.save') %></button>
                  <button type="button" class="btn btn-ghost btn-sm" data-action="category-cancel" data-id="<%= cat.id %>"><%= t('common.cancel') %></button>
                </div>
              </div>
            </div>
          </dialog>
        </div>
        <div class="record-total record-total--<%= cat.colorKey %>">
          <strong><%= pctText(cat.progress.percentage) %></strong>
          <span><%= t('admin.ofTotal', { done: cat.progress.completed, total: cat.progress.total }) %></span>
        </div>
      </div>
      <div class="pbar pbar--<%= cat.colorKey %>" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= Math.round(cat.progress.percentage) %>" aria-label="<%= t('admin.progressOf', { stage: cat.title }) %>">
        <div class="pbar-fill pbar-fill--<%= cat.colorKey %>" style="--fill: <%= pctBar(cat.progress.percentage) %>"></div>
      </div>

      <%
        // Atajo de creación al principio de la etapa: abre el mismo formulario
        // de «Nueva actividad» con esta etapa ya elegida y la posición 1, así
        // que nada se añade al final por descuido. Va fuera de la lista para no
        // contar como actividad en el arrastre ni en la paginación.
      %>
      <button type="button" class="task-add-row" data-add-task-top data-category-id="<%= cat.id %>" aria-label="<%= t('admin.taskAddAtTopAria', { stage: cat.title }) %>">
        <span class="task-add-row__glyph"><i data-lucide="plus"></i></span>
        <span class="task-add-row__text"><%= t('admin.taskAddAtTop') %></span>
        <span class="task-add-row__hint"><%= t('admin.taskPosition1') %></span>
      </button>

      <ul class="task-list task-list--admin" data-task-dropzone data-category-id="<%= cat.id %>" aria-describedby="task-drag-help">
        <% cat.tasks.forEach(function(task) { %>
        <% const assignedUsers = Array.isArray(task.assigned_users) ? task.assigned_users : (task.assigned_user_id ? [{ id: task.assigned_user_id, name: task.assigned_user_name || '', displayName: task.assigned_user_name || '', shortName: task.assigned_user_name || '' }] : []); %>
        <% const assignedIds = assignedUsers.map(function(u) { return u.id; }); %>
        <% const shownAssignees = assignedUsers.slice(0, 5); const extraAssignees = assignedUsers.length - shownAssignees.length; %>
        <li class="task task--<%= task.status %>" data-task-id="<%= task.id %>">
          <div class="task-summary">
            <button type="button" class="task-drag-handle" data-task-drag-handle aria-label="<%= t('admin.reorderTaskAria', { title: task.title }) %>" aria-describedby="task-drag-help" title="<%= t('admin.dragToReorder') %>">
              <i data-lucide="grip-vertical"></i>
              <span class="visually-hidden"><%= t('admin.reorderTask') %></span>
            </button>
            <span class="task-glyph"><i data-lucide="<%= task.status === 'completed' ? 'circle-check-big' : task.status === 'in_progress' ? 'loader-circle' : 'circle' %>"></i></span>
            <span class="task-text" title="<%= task.title %>"><%= task.title %></span>
            <span class="task-status task-status--<%= task.status %>"><%= statusLabel(task.status, lang) %></span>
            <% if (assignedUsers.length === 0) { %>
            <span class="task-assignee"><%= t('admin.taskUnassigned') %></span>
            <% } else { %>
            <span class="assignee">
              <button type="button" class="assignee-bubble" data-assignee-toggle aria-expanded="false" aria-label="<%= assignedUsers.length === 1 ? t('admin.assigneeAria') : t('admin.assigneesAria', { n: assignedUsers.length }) %>">
                <i data-lucide="user" class="assignee-icon"></i>
                <span class="assignee-count"><%= assignedUsers.length %></span>
              </button>
              <div class="assignee-popover" role="tooltip">
                <% shownAssignees.forEach(function(u) { %><p><%= u.shortName %></p><% }) %>
                <% if (extraAssignees > 0) { %><p class="assignee-popover__more"><%= extraAssignees === 1 ? t('roadmap.oneMoreCollaborator') : t('roadmap.moreCollaborators', { n: extraAssignees }) %></p><% } %>
              </div>
            </span>
            <% } %>
            <div class="task-actions">
              <button type="button" class="ctl ctl-btn ctl-pin" data-action="toggle-pin" data-id="<%= task.id %>" aria-pressed="<%= task.order_pinned ? 'true' : 'false' %>" aria-label="<%= task.order_pinned ? t('admin.taskUnpinAria') : t('admin.taskPinAria') %>" title="<%= task.order_pinned ? t('admin.taskPinnedTitle') : t('admin.taskPin') %>"><i data-lucide="pin"></i></button>
              <button type="button" class="ctl ctl-btn ctl-edit-toggle" data-action="toggle-edit" data-id="<%= task.id %>" aria-expanded="false" aria-controls="edit-<%= task.id %>" aria-label="<%= t('admin.taskEdit') %>"><i data-lucide="pencil"></i></button>
              <button type="button" class="ctl ctl-btn ctl-danger" data-action="delete" data-id="<%= task.id %>" aria-label="<%= t('common.delete') %>"><i data-lucide="trash-2"></i></button>
            </div>
          </div>

          <dialog class="modal modal--lg" id="edit-<%= task.id %>" aria-label="<%= t('admin.taskEditAria', { title: task.title }) %>">
            <div class="modal__panel">
              <div class="modal__head">
                <div class="modal__titles">
                  <span class="kicker kicker--<%= cat.colorKey %>"><%= t('admin.taskEditKicker') %></span>
                  <h2 class="modal__title" data-modal-title><%= task.title %></h2>
                </div>
                <button type="button" class="modal__close" data-action="cancel-edit" data-id="<%= task.id %>" aria-label="<%= t('common.close') %>"><i data-lucide="x"></i></button>
              </div>
              <div class="modal__body task-edit">
                <div class="field">
                  <label for="title-<%= task.id %>"><%= t('admin.taskTitleLabel') %></label>
                  <input type="text" id="title-<%= task.id %>" data-title-input data-id="<%= task.id %>" value="<%= task.title %>" maxlength="300">
                </div>

                <div class="task-edit-row">
                  <div class="field">
                    <label for="status-<%= task.id %>"><%= t('admin.taskStatus') %></label>
                    <select id="status-<%= task.id %>" class="ctl ctl-status" data-field="status" data-id="<%= task.id %>">
                      <option value="pending" <%- task.status === 'pending' ? 'selected' : '' %>><%= t('status.pending') %></option>
                      <option value="in_progress" <%- task.status === 'in_progress' ? 'selected' : '' %>><%= t('status.in_progress') %></option>
                      <option value="completed" <%- task.status === 'completed' ? 'selected' : '' %>><%= t('status.completed') %></option>
                    </select>
                  </div>

                  <div class="field">
                    <label for="cat-<%= task.id %>"><%= t('admin.taskCategory') %></label>
                    <select id="cat-<%= task.id %>" class="ctl ctl-cat" data-field="category" data-id="<%= task.id %>">
                      <% view.categories.forEach(function(c) { %>
                      <option value="<%= c.id %>" <%- c.id === task.category_id ? 'selected' : '' %>><%= c.title %></option>
                      <% }) %>
                    </select>
                  </div>
                </div>

                <div class="field field--wide">
                  <span class="field-label" id="assign-label-<%= task.id %>"><%= t('admin.taskOwners') %></span>
                  <div class="assignee-picker" data-assignee-picker>
                    <div class="assignee-search">
                      <input type="text" class="assignee-search-input" data-assignee-search placeholder="<%= t('admin.taskSearchPeople') %>" autocomplete="off" role="combobox" aria-expanded="false" aria-autocomplete="list" aria-labelledby="assign-label-<%= task.id %>">
                      <div class="assignee-results" data-assignee-results hidden></div>
                    </div>
                    <div class="assignee-chips" data-assignee-chips></div>
                    <div class="visually-hidden" data-assignment-group data-id="<%= task.id %>" aria-hidden="true">
                      <% availableUsers.forEach(function(user) { %>
                      <label for="assign-<%= task.id %>-<%= user.id %>">
                        <input type="checkbox" id="assign-<%= task.id %>-<%= user.id %>" value="<%= user.id %>" data-assignment-checkbox tabindex="-1" <%- assignedIds.indexOf(user.id) >= 0 ? 'checked' : '' %>>
                        <span><%= displayName(user) %></span>
                      </label>
                      <% }) %>
                    </div>
                  </div>
                </div>

                <div class="form-actions modal__actions">
                  <button type="button" class="btn btn-red btn-sm" data-action="save-task" data-id="<%= task.id %>"><%= t('common.saveChanges') %></button>
                  <button type="button" class="btn btn-ghost btn-sm" data-action="cancel-edit" data-id="<%= task.id %>"><%= t('common.cancel') %></button>
                </div>
              </div>
            </div>
          </dialog>
        </li>
        <% }) %>
        <% if (cat.tasks.length === 0) { %>
        <li class="task task--empty"><%= t('admin.taskEmpty') %></li>
        <% } %>
      </ul>

      <div class="cat-pagination" data-cat-pagination data-cat-slug="<%= cat.slug %>" <%- cat.tasks.length > 5 ? '' : 'hidden' %>>
        <div class="cat-pagination__size">
          <label for="pagesize-<%= cat.slug %>"><%= t('admin.perPageLabel') %></label>
          <select id="pagesize-<%= cat.slug %>" data-page-size aria-label="<%= t('admin.perPageIn', { stage: cat.title }) %>">
            <option value="5" selected>5</option>
            <option value="10">10</option>
            <option value="15">15</option>
            <option value="20">20</option>
            <option value="25">25</option>
            <option value="all"><%= t('common.all') %></option>
          </select>
        </div>
        <div class="cat-pagination__nav">
          <button type="button" class="ctl ctl-btn" data-page-prev aria-label="<%= t('admin.prevPage') %>"><i data-lucide="chevron-left"></i></button>
          <span class="cat-pagination__status" data-page-status><%= t('common.pageNofM', { n: 1, total: 1 }) %></span>
          <button type="button" class="ctl ctl-btn" data-page-next aria-label="<%= t('admin.nextPage') %>"><i data-lucide="chevron-right"></i></button>
        </div>
      </div>
    </div>
    <% }) %>
    </div>
  </div>
</section>
</main>

<%- include('partials/footer', { showVisitCounter: false }) %>
<script src="<%= basePath %>/static/admin.js?v=<%= assetVersion %>" defer></script>
<script src="<%= basePath %>/static/metrics.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
