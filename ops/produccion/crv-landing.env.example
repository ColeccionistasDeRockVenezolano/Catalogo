# CRV · Gateway de la portada (Fase 2B). Copiar a ~/apps/crv-landing/gateway.env (0600).
NODE_ENV=production
CRV_DEPLOYMENT=production
CRV_WEB_MODE=landing
# Vacío = la portada se sirve en la raíz del dominio.
CRV_PUBLIC_PATH=
CRV_WEB_HOST=127.0.0.1
CRV_WEB_TRUST_CF_HEADERS=true
CRV_WEB_PORT=3140
# Build con base «/»: npm --prefix web run build (NO dist-public ni dist-staging).
CRV_WEB_DIST=dist
CRV_WEB_REDIRECT_UNPREFIXED=0
CRV_API_HOST=127.0.0.1
CRV_API_PORT=8083
CRV_CHAT_PORT=8099
# La radio sigue viniendo de Herra hasta la Fase 3.
CRV_RADIO_PROXY_URL=http://127.0.0.1:3020
# Corte de la radio (docs/independencia/FASE3.md §8): cambiar la línea anterior por:
# CRV_RADIO_SOURCE=crv
