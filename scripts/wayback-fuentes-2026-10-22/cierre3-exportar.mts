import {readFileSync,writeFileSync,existsSync} from 'node:fs';import {getPool,closeDb} from '../../src/db/client.js';
const out=process.env['WAYBACK_OUT']!;if(!out||existsSync(out+'/antes.json'))throw Error('Ruta ausente o línea base existente');const previous='reports/wayback-finalizacion-2-2026-10-25',ledger=JSON.parse(readFileSync(previous+'/PENDIENTES.json','utf8')),candidates=JSON.parse(readFileSync(previous+'/biografias-candidatas-restantes.json','utf8'));const ids=[...new Set([...candidates.map((r:any)=>r.artistId),...ledger.sourceConflictDocuments.map((d:any)=>d.artistId)])];const p=getPool(),c=await p.connect();try{await c.query('BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY');const q=async(s:string,a:any[]=[]) =>(await c.query(s,a)).rows;const r={at:new Date().toISOString(),ledger,candidates,artists:await q('SELECT * FROM public.artists WHERE id=ANY($1::bigint[]) ORDER BY id',[ids]),documents:await q("SELECT * FROM media.artist_documents WHERE artist_id=ANY($1::bigint[]) AND $2=ANY(tags) ORDER BY id",[ids,'archivo-wayback-2026-10-22']),members:await q('SELECT m.*,p.name person_name FROM public.artist_members m JOIN public.persons p ON p.id=m.person_id WHERE artist_id=ANY($1::bigint[])',[ids]),albums:await q('SELECT * FROM public.albums WHERE artist_id=ANY($1::bigint[]) ORDER BY id',[ids]),events:await q('SELECT * FROM ingest.ephemerides WHERE original_artist_id=ANY($1::bigint[]) ORDER BY id',[ids])};writeFileSync(out+'/antes.json',JSON.stringify(r,null,2));console.log(JSON.stringify({artists:r.artists.length,documents:r.documents.length,candidates:candidates.length,conflicts:ledger.sourceConflictDocuments.length}));await c.query('COMMIT');}finally{c.release();await closeDb();}
