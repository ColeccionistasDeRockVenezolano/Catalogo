/** Verificación independiente de operaciones y de sus efectos finales. Sólo lectura. */
import {readFileSync,writeFileSync,readdirSync,existsSync,statSync}from'node:fs';
import path from'node:path';import{createHash}from'node:crypto';
import{getPool,closeDb}from'../src/db/client.js';
const data=process.env['HERMES_DATA'],report=process.env['HERMES_REPORT'];if(!data||!report)throw new Error('Faltan rutas de campaña');
const read=(p:string):Record<string,unknown>[]=>readFileSync(p,'utf8').split('\n').filter(Boolean).map(l=>JSON.parse(l) as Record<string,unknown>);
const norm=(s:string)=>s.normalize('NFKD').replace(/\p{M}/gu,'').toLowerCase().replace(/[^a-z0-9]+/gu,' ').trim();
const db=getPool();const logs=readdirSync(report).filter(f=>f.endsWith('-applied.jsonl'));const runs:number[]=[],operations:Record<string,Record<string,unknown>[]>={};
for(const f of logs){const phase=f.replace('-applied.jsonl','');operations[phase]=[];for(const row of read(path.join(report,f))){runs.push(Number(row['runId']));operations[phase]!.push(...row['results'] as Record<string,unknown>[]);}}
const ids=(phase:string,key:string,createdOnly=false)=>[...new Set((operations[phase]??[]).filter(r=>!createdOnly||r['created']).map(r=>Number(r[key])).filter(Boolean))];
const checks:Record<string,unknown>={};
try{
 checks['journal']=(await db.query('SELECT table_name,op,count(*)::int n FROM ingest.change_journal WHERE run_id=ANY($1::bigint[]) GROUP BY table_name,op ORDER BY table_name,op',[runs])).rows;
 const queries:Record<string,string>={artists:'SELECT count(*)::int n FROM public.artists',persons:'SELECT count(*)::int n FROM public.persons',members:'SELECT count(*)::int n FROM public.artist_members',albums:'SELECT count(*)::int n FROM public.albums',tracks:'SELECT count(*)::int n FROM public.tracks',documents:'SELECT count(*)::int n FROM media.artist_documents',gallery:'SELECT count(*)::int n FROM media.artist_gallery',audiovisuals:'SELECT count(*)::int n FROM media.artist_audiovisuals'};
 const counts:Record<string,number>={};for(const[k,sql]of Object.entries(queries))counts[k]=(await db.query<{n:number}>(sql)).rows[0]!.n;checks['counts']=counts;
 const vidids=ids('videos','audiovisualId');checks['unplayableNewVideos']=(await db.query(`SELECT av.id,v.video_id,v.publication_status,v.metadata->'status' status FROM media.artist_audiovisuals av JOIN media.youtube_videos v ON v.id=av.video_id WHERE av.id=ANY($1::bigint[]) AND (v.publication_status NOT IN('published','unlisted') OR v.metadata->'status'->>'embeddable' IS DISTINCT FROM 'true' OR v.metadata->'status'->>'privacyStatus' NOT IN('public','unlisted'))`,[vidids])).rows;
 checks['duplicateNewVideoRelations']=(await db.query(`SELECT av.artist_id,av.video_id,count(*) n FROM media.artist_audiovisuals av WHERE (av.artist_id,av.video_id)IN(SELECT artist_id,video_id FROM media.artist_audiovisuals WHERE id=ANY($1::bigint[])) GROUP BY av.artist_id,av.video_id HAVING count(*)>1`,[vidids])).rows;
 const artistids=ids('artists','artistId',true),albumids=ids('albums','albumId',true);
 const artists=(await db.query<{id:string;name:string}>('SELECT id::text,name FROM public.artists')).rows;
 const artistnames=new Map<string,string[]>();for(const a of artists){const n=norm(a.name);artistnames.set(n,[...(artistnames.get(n)??[]),a.id]);}
 checks['duplicateNewArtists']=artists.filter(a=>artistids.includes(Number(a.id))&&(artistnames.get(norm(a.name))?.length??0)>1);
 const albums=(await db.query<{id:string;artist_id:string;title:string}>('SELECT id::text,artist_id::text,title FROM public.albums')).rows;const albumkeys=new Map<string,string[]>();
 for(const a of albums){const key=a.artist_id+':'+norm(a.title);albumkeys.set(key,[...(albumkeys.get(key)??[]),a.id]);}
 checks['duplicateNewAlbums']=albums.filter(a=>albumids.includes(Number(a.id))&&(albumkeys.get(a.artist_id+':'+norm(a.title))?.length??0)>1);
 const baseline=JSON.parse(readFileSync(path.join(data,'catalogue.json'),'utf8')) as {albums:{id:string}[]};const currentAlbums=new Set(albums.map(a=>a.id));const absent=baseline.albums.filter(a=>!currentAlbums.has(a.id)).map(a=>Number(a.id));
 checks['albumDeletionsOutsideCampaign']=(await db.query(`SELECT j.run_id,j.row_pk,j.old_data->>'title' title,r.params->>'action' action,r.params->>'operator' operator,r.params->>'note' note FROM ingest.change_journal j LEFT JOIN ingest.scrape_runs r ON r.id=j.run_id WHERE j.table_name='public.albums' AND j.op='D' AND (j.row_pk->>'id')::bigint=ANY($1::bigint[]) AND NOT(j.run_id=ANY($2::bigint[])) ORDER BY j.id`,[absent,runs])).rows;
 const galleryids=ids('gallery','galleryId');checks['duplicateNewGalleryHashes']=(await db.query(`SELECT artist_id,metadata->>'sha256' sha256,count(*) n FROM media.artist_gallery WHERE (artist_id,metadata->>'sha256')IN(SELECT artist_id,metadata->>'sha256' FROM media.artist_gallery WHERE id=ANY($1::bigint[])) GROUP BY artist_id,metadata->>'sha256' HAVING count(*)>1`,[galleryids])).rows;
 const allAffected=[...new Set([...ids('artists','artistId'),...((await db.query<{artist_id:string}>('SELECT artist_id::text FROM media.artist_documents WHERE metadata->>\'campaign\'=$1',["hermes-integral-2026-10-24"])).rows.map(r=>Number(r.artist_id)))])];
 checks['excludedArtistsTouched']=(await db.query(`SELECT a.id,a.name FROM public.artists a WHERE a.id=ANY($1::bigint[]) AND(EXISTS(SELECT 1 FROM ingest.artist_editorial_policy p WHERE p.artist_id=a.id)OR EXISTS(SELECT 1 FROM ingest.artist_editorial_names n WHERE n.name_key=ingest.editorial_name_key(a.name)))`,[allAffected])).rows;
 checks['captures']=(await db.query(`SELECT coalesce((extraction->>'binary')::boolean,false) AS is_binary,count(*)::int n FROM ingest.research_source_captures WHERE extraction->>'campaign'=$1 GROUP BY 1`,['hermes-integral-2026-10-24'])).rows;
 checks['evidenceDocuments']=(await db.query(`SELECT count(*)::int n FROM ingest.evidence_documents WHERE extraction_metadata->>'campaign'=$1`,['hermes-integral-2026-10-24'])).rows[0];
 checks['factStates']=(await db.query(`SELECT f.documentary_state,b.disposition,count(*)::int n FROM ingest.catalog_facts f JOIN ingest.catalog_fact_bindings b ON b.fact_id=f.id WHERE f.run_id=ANY($1::bigint[]) GROUP BY f.documentary_state,b.disposition`,[runs])).rows;
 checks['reviewCount']=(await db.query(`SELECT count(*)::int n FROM ingest.review_queue WHERE payload->>'campaign'=$1`,['hermes-integral-2026-10-24'])).rows[0];
 checks['reviewStates']=(await db.query(`SELECT status,count(*)::int n FROM ingest.review_queue WHERE payload->>'campaign'=$1 GROUP BY status`,['hermes-integral-2026-10-24'])).rows;
 checks['activeCampaignRows']={};for(const [key,table,meta]of [['documents','media.artist_documents','metadata'],['gallery','media.artist_gallery','metadata'],['audiovisuals','media.artist_audiovisuals','metadata'],['mediaLinks','media.media_links','meta']] as const){(checks['activeCampaignRows'] as Record<string,unknown>)[key]=(await db.query(`SELECT count(*)::int n FROM ${table} WHERE ${meta}->>'campaign'=$1`,['hermes-integral-2026-10-24'])).rows[0];}
 checks['duplicateReviewKeys']=(await db.query(`SELECT payload->>'hermesIntegralKey' key,count(*)::int n FROM ingest.review_queue WHERE payload->>'campaign'=$1 GROUP BY 1 HAVING count(*)>1`,['hermes-integral-2026-10-24'])).rows;
 checks['duplicateNewTrackPositions']=(await db.query(`SELECT t.album_id,t.disc_number,t.track_number,count(*)::int n FROM public.tracks t WHERE t.album_id IN(SELECT (new_data->>'album_id')::bigint FROM ingest.change_journal WHERE run_id=ANY($1::bigint[]) AND table_name='public.tracks' AND op='I') GROUP BY 1,2,3 HAVING count(*)>1`,[runs])).rows;
 const files:Record<string,unknown>[]=[];let jsonHashes=0,binarySizes=0;
 const datasets=[data,...(process.env['HERMES_SUPPLEMENT']??'').split(path.delimiter).filter(Boolean)];
 const coverage:Record<string,unknown>={};
 for(const phase of ['artists','assets','albums','videos','gallery','documents','facts','members','links','songs','reviews']){const expected=read(path.join(data,'plan-'+phase+'.jsonl'));const actual=new Set((operations[phase]??[]).map(r=>r['key']));coverage[phase]={expected:expected.length,missing:expected.filter(r=>!actual.has(r['key'])).map(r=>r['key'])};}
 checks['mainPlanCoverage']=coverage;
 const volumePlans=datasets.flatMap(d=>existsSync(path.join(d,'plan-albums.jsonl'))?read(path.join(d,'plan-albums.jsonl')).filter(r=>r['editorialDistinctEdition']):[]);
 const albumResults=new Map((operations['albums']??[]).filter(r=>r['albumId']).map(r=>[r['key'],Number(r['albumId'])]));const volumeProblems:Record<string,unknown>[]=[];let verifiedVolumeTracks=0;
 for(const p of volumePlans){const id=albumResults.get(p['key']);if(!id){volumeProblems.push({key:p['key'],reason:'missing album'});continue;}
  const stored=(await db.query<{title:string;disc_number:number;track_number:number;duration_seconds:number|null}>('SELECT title,disc_number,track_number,duration_seconds FROM public.tracks WHERE album_id=$1',[id])).rows;const expected=p['tracks'] as {n:number;disc:number;title:string;duration?:number|null}[];
  for(const t of expected){const found=stored.find(s=>s.disc_number===t.disc&&s.track_number===t.n&&norm(s.title)===norm(t.title)&&s.duration_seconds===(t.duration??null));if(found)verifiedVolumeTracks++;else volumeProblems.push({key:p['key'],track:t});}
  if(stored.length!==expected.length)volumeProblems.push({key:p['key'],expected:expected.length,stored:stored.length});
 }
 checks['documentedCompilationTracks']={volumes:volumePlans.length,verifiedTracks:verifiedVolumeTracks,failures:volumeProblems};
 checks['withdrawnRestored']=(await db.query(`SELECT av.id::text,'video' kind FROM media.artist_audiovisuals av JOIN ingest.review_queue q ON av.source_key=$1||':'||(q.payload->'record'->>'originalKey') WHERE q.payload->>'campaign'=$1 AND q.payload->'record'->>'withdrawKind'='video' UNION ALL SELECT m.id::text,'link' kind FROM media.media_links m JOIN ingest.review_queue q ON m.meta->>'key'=q.payload->'record'->>'originalKey' WHERE q.payload->>'campaign'=$1 AND q.payload->'record'->>'withdrawKind'='link' AND m.meta->>'campaign'=$1`,['hermes-integral-2026-10-24'])).rows;
 for(const dataset of datasets)for(const c of read(path.join(dataset!,'captures.jsonl'))){const p=path.resolve(String(c['storedPath']));if(!existsSync(p)||statSync(p).size!==c['bytes'])files.push({key:c['key'],reason:'missing/size'});else if(createHash('sha256').update(readFileSync(p)).digest('hex')!==c['rawHash'])files.push({key:c['key'],reason:'hash'});else jsonHashes++;}
 for(const dataset of datasets)if(existsSync(path.join(dataset,'plan-assets.jsonl')))for(const c of read(path.join(dataset,'plan-assets.jsonl'))){const p=path.resolve(String(c['storedPath']));if(!existsSync(p)||statSync(p).size!==c['bytes'])files.push({key:c['key'],reason:'missing/size'});else binarySizes++;}
 checks['files']={jsonHashes,binarySizes,failures:files};
 const summary=Object.fromEntries(Object.entries(operations).map(([p,rs])=>[p,{attempts:rs.length,uniqueKeys:new Set(rs.map(r=>r['key'])).size,created:rs.filter(r=>r['created']).length,reused:rs.filter(r=>r['reused']).length,needsReview:rs.filter(r=>r['needsReview']).length,tracksCreated:rs.reduce((n,r)=>n+Number(r['tracksCreated']??0),0),personsCreated:rs.filter(r=>r['personCreated']).length,appliedFacts:rs.filter(r=>r['applied']).length,corrected:rs.filter(r=>r['corrected']).length}]));
 const result={checkedAt:new Date().toISOString(),runIds:[...new Set(runs)],operations:summary,checks};writeFileSync(path.join(report,'verificacion-final.json'),JSON.stringify(result,null,2));console.log(JSON.stringify(result));
}finally{await closeDb();}
