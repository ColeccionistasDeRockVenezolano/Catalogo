[Unit]
Description=CRV Spotify diario: reproductores de la campaña 2026-11-02 (prioridad 1: perfil verificado), con tope por credencial
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/brian/apps/Coleccionistas De Rock Venezolano
ExecStart=/home/brian/.venvs/crv-embeds/bin/python -I "/home/brian/apps/Coleccionistas De Rock Venezolano/ops/spotify-diario/diario.py" --entrada reports/streaming-embeds-2026-11-02 --prioridad 1
StandardOutput=append:/home/brian/apps/Coleccionistas De Rock Venezolano/data/raw/spotify-diario/diario.log
StandardError=append:/home/brian/apps/Coleccionistas De Rock Venezolano/data/raw/spotify-diario/diario.log
TimeoutStartSec=6h
