import {chromium} from 'playwright';import {writeFileSync} from 'node:fs';
const out=process.env['WAYBACK_OUT']!;const b=await chromium.launch({headless:true,args:['--no-sandbox']});const r:any={at:new Date().toISOString(),pages:[],failures:[]};
try{for(const [id,name,needle,forbidden] of [[725,'Abismo','noviembre de 2006','Universidad de los Andes'],[8591,'Abismo (Mérida)','Mérida','Espíritu Inmortal'],[834,'Atiko','Valencia','con Carlos en la voz, Thomas'],[8594,'Atiko (Barquisimeto)','Barquisimeto','Juan Manuel Ponce']] as const){const p=await b.newPage({viewport:{width:1360,height:1000}});const errors:string[]=[];p.on('pageerror',e=>errors.push(String(e)));try{await p.goto('http://127.0.0.1:3120/crv/artistas/'+id,{waitUntil:'domcontentloaded',timeout:30000});await p.getByRole('heading',{name,exact:true}).waitFor({state:'visible',timeout:20000});const text=await p.locator('.artist-profile__biography').innerText();if(!text.includes(needle)||text.includes(forbidden)||errors.length)throw Error('Biografía cruzada, ausente o error JS');await p.screenshot({path:out+'/ui/identity-'+id+'.png'});r.pages.push({id,name,text,errors});}catch(e){r.failures.push({id,error:String(e)});}await p.close();}writeFileSync(out+'/identidades-ui-verificacion.json',JSON.stringify(r,null,2));console.log(JSON.stringify({pages:r.pages.length,failures:r.failures}));if(r.failures.length)process.exitCode=1;}finally{await b.close();}
