    <%= t('nav.tools') %><i data-lucide="chevron-down" class="nav-dropdown__caret"></i>
  </button>
  <ul class="nav-dropdown__menu">
    <li><a href="<%= projectBase %>/"><%= t('nav.roadmap') %></a></li>
    <li><a href="<%= projectBase %>/kanban"><%= t('nav.kanban') %></a></li>
  </ul>
</li>
<% } else { %>
<li class="nav-group-label"><%= t('nav.tools') %></li>
<li><a class="nav-sublink" href="<%= projectBase %>/"><%= t('nav.roadmap') %></a></li>
<li><a class="nav-sublink" href="<%= projectBase %>/kanban"><%= t('nav.kanban') %></a></li>
