[Unit]
Description=CRV - agregación y retención de métricas propias
After=network.target crv-postgres.service
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=oneshot
User=brian
WorkingDirectory=/home/brian/apps/Coleccionistas De Rock Venezolano
ExecStart="/home/brian/apps/Coleccionistas De Rock Venezolano/scripts/with-node22.sh" tsx scripts/discovery-metrics.ts aggregate
Environment="PATH=/home/brian/apps/Coleccionistas De Rock Venezolano/node_modules/.bin:/usr/local/bin:/usr/bin:/bin"
Restart=on-failure
RestartSec=300
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
