<% const launchEn = lang === 'en'; %>
<dialog class="launch-modal" id="launch-modal" aria-labelledby="launch-title" aria-describedby="launch-description" data-hj-suppress>
  <button class="launch-modal__close" type="button" data-launch-close aria-label="<%= launchEn ? 'Close' : 'Cerrar' %>">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
  </button>
  <div class="launch-modal__content" data-launch-intro>
    <svg class="launch-modal__mark" viewBox="0 0 40 40" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 8h6v25H7zM17 8h6v25h-6zM26 10l6-1 4 23-6 1zM7 26h6M17 26h6M29 26l6-1"/></svg>
    <h2 id="launch-title"><%= launchEn ? 'Our music.' : 'Nuestra música.' %><br><span><%= launchEn ? 'A new home.' : 'Un nuevo hogar.' %></span></h2>
    <p id="launch-description"><%= launchEn ? 'The digital library of Venezuelan rock is on its way. Leave your email and we’ll tell you when it opens.' : 'La biblioteca digital del rock venezolano está en camino. Déjanos tu correo y te avisamos al abrir.' %></p>
    <form class="launch-form" id="launch-form" data-hj-suppress>
      <div class="launch-form__field">
        <label for="launch-name"><%= launchEn ? 'Your name' : 'Tu nombre' %></label>
        <input id="launch-name" name="name" autocomplete="name" required minlength="2" maxlength="120" placeholder="<%= launchEn ? 'First and last name' : 'Nombre y apellido' %>" aria-describedby="launch-name-error">
        <span id="launch-name-error" class="launch-form__error" hidden></span>
      </div>
      <div class="launch-form__field">
        <label for="launch-email"><%= launchEn ? 'Email' : 'Correo electrónico' %></label>
        <input id="launch-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" placeholder="<%= launchEn ? 'you@example.com' : 'tu@correo.com' %>" aria-describedby="launch-email-error" autocapitalize="none" spellcheck="false">
        <span id="launch-email-error" class="launch-form__error" hidden></span>
      </div>
      <div class="launch-form__field">
        <label for="launch-type"><%= launchEn ? 'How do you connect with music?' : '¿Cómo te conectas con la música?' %></label>
        <select id="launch-type" name="type" required aria-describedby="launch-type-error">
          <option value="" selected disabled><%= launchEn ? 'Choose what best describes you' : 'Elige lo que más te identifica' %></option>
          <option value="Oyente"><%= launchEn ? 'Listener' : 'Oyente' %></option>
          <option value="Músico / banda"><%= launchEn ? 'Musician / band' : 'Músico / banda' %></option>
          <option value="Investigador"><%= launchEn ? 'Researcher' : 'Investigador' %></option>
          <option value="Coleccionista"><%= launchEn ? 'Collector' : 'Coleccionista' %></option>
        </select>
        <span id="launch-type-error" class="launch-form__error" hidden></span>
      </div>
      <details class="launch-form__optional">
        <summary><%= launchEn ? 'Add phone or social profiles' : 'Añadir teléfono o redes' %><span><%= launchEn ? 'Optional' : 'Opcional' %></span></summary>
        <div class="launch-form__field">
          <label for="launch-phone"><%= launchEn ? 'Phone' : 'Teléfono' %></label>
          <input id="launch-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" placeholder="+58 412 123 4567" aria-describedby="launch-phone-hint launch-phone-error">
          <small id="launch-phone-hint"><%= launchEn ? 'Include your country code.' : 'Incluye el código de tu país.' %></small>
          <span id="launch-phone-error" class="launch-form__error" hidden></span>
        </div>
        <div class="launch-form__field">
          <label for="launch-social"><%= launchEn ? 'Social profiles' : 'Redes sociales' %></label>
          <input id="launch-social" name="social" maxlength="500" placeholder="<%= launchEn ? '@username or profile link' : '@usuario o enlace a tu perfil' %>" autocapitalize="none" spellcheck="false" aria-describedby="launch-social-error">
          <span id="launch-social-error" class="launch-form__error" hidden></span>
        </div>
      </details>
      <div class="launch-form__trap" aria-hidden="true" inert><label for="launch-website">Website</label><input id="launch-website" name="website" tabindex="-1" autocomplete="off"></div>
      <p class="launch-form__status" id="launch-error" role="alert" hidden></p>
      <button class="launch-form__submit" type="submit"><span data-launch-submit-label><%= launchEn ? 'Notify me at launch' : 'Avísame del lanzamiento' %></span><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></button>
      <p class="launch-form__privacy"><%= launchEn ? 'By submitting, you agree to be contacted about the library’s launch.' : 'Al enviar, aceptas que te contactemos para avisarte del lanzamiento de la biblioteca.' %></p>
    </form>
    <button class="launch-modal__later" type="button" data-launch-close><%= launchEn ? 'Explore for now' : 'Por ahora, quiero explorar' %></button>
  </div>
  <div class="launch-modal__success" data-launch-success hidden role="status" aria-live="polite" tabindex="-1">
    <svg class="launch-modal__mark" viewBox="0 0 40 40" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="20" cy="20" r="16"/><path d="m12 20 5 5 11-11"/></svg>
    <h2><%= launchEn ? 'You’re on the list.' : 'Ya eres parte.' %></h2>
    <p><%= launchEn ? 'Your registration is saved. We’ll let you know when the digital library opens. Meanwhile, there’s music to discover.' : 'Tu registro está guardado. Te avisaremos cuando abra la biblioteca digital. Mientras tanto, hay música por descubrir.' %></p>
    <button class="launch-form__submit" type="button" data-launch-close><%= launchEn ? 'Keep exploring' : 'Seguir explorando' %></button>
  </div>
</dialog>
