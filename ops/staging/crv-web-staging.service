[Unit]
Description=CRV web staging (dist-staging, 127.0.0.1:3130)
After=network-online.target crv-api-staging.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/brian/apps/Coleccionistas De Rock Venezolano/web
Environment=PATH=/home/brian/.local/node-v24.20.0-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
Environment=CRV_WEB_HOST=127.0.0.1
Environment=CRV_WEB_PORT=3130
Environment=CRV_API_PORT=8082
Environment=CRV_CHAT_PORT=8099
Environment=CRV_PUBLIC_PATH=crv
Environment=CRV_WEB_DIST=dist-staging
Environment=CRV_WEB_MODE=catalog
Environment=CRV_WEB_REDIRECT_UNPREFIXED=1
ExecStart=/home/brian/.local/node-v24.20.0-linux-x64/bin/npm run serve:public
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
