import {writeFileSync} from 'node:fs';import {getPool,closeDb} from '../../src/db/client.js';const out=process.env['WAYBACK_OUT']!,p=getPool();try{const tag='archivo-wayback-2026-10-22';const result={at:new Date().toISOString(),yearOnly:(await p.query("SELECT count(*)::int total FROM ingest.ephemerides WHERE event_key LIKE $1 AND event_date IS NULL",[tag+':%'])).rows[0],audiovisuals:(await p.query("SELECT av.id,av.artist_id,av.title,av.video_id,av.metadata,v.video_id youtube_id,v.publication_status FROM media.artist_audiovisuals av LEFT JOIN media.youtube_videos v ON v.id=av.video_id WHERE av.metadata::text LIKE '%wayback%' ORDER BY av.id")).rows,sourceConflicts:(await p.query("SELECT id,artist_id,title,metadata FROM media.artist_documents WHERE $1=ANY(tags) AND $2=ANY(tags) ORDER BY id",[tag,'conflicto-documentado'])).rows,abismo:(await p.query('SELECT id,name,origin_city,formed_year FROM public.artists WHERE id=ANY($1::bigint[])',[[725,8591]])).rows,atiko:(await p.query('SELECT id,name,origin_city,formed_year FROM public.artists WHERE id=ANY($1::bigint[])',[[834,8594]])).rows};writeFileSync(out+'/estado-final.json',JSON.stringify(result,null,2));console.log(JSON.stringify({yearOnly:result.yearOnly,audiovisuals:result.audiovisuals.length,unplayable:result.audiovisuals.filter(a=>!a.video_id).map(a=>a.id),sourceConflicts:result.sourceConflicts.length,resolved:result.sourceConflicts.filter(d=>d.metadata.conflictResolution||d.metadata.identityCorrection).map(d=>d.id)}));}finally{await closeDb();}
