import {readFileSync,writeFileSync} from 'node:fs';import {getPool,closeDb} from '../../src/db/client.js';import {withOperatorRun} from '../../src/merge/operator.js';import {WAYBACK_ARCHIVE_TAG as TAG} from '../../src/shared/artist-documents.js';
const root='reports/wayback-analisis-catalogo-2026-10-22/',out=process.env['WAYBACK_OUT']??`${process.env['HOME']}/crv-staging/reports/wayback-incorporacion-2026-10-23`;
const rows=(f:string):any[]=>readFileSync(root+f+'.jsonl','utf8').trim().split('\n').filter(Boolean).map(x=>JSON.parse(x));
const radio=rows('radio-deduplicada'),indecente=rows('galeria-obras-cotejadas').find(r=>r.artista_fuente==='Americania'&&r.titulo_fuente==='Indecente');
const result=await withOperatorRun({name:'wayback:documentary-complements',operator:'codex',note:'Conservar lista histórica de difusión y conflicto audiovisual sin crear discografía por una referencia.',params:{campaign:TAG}},async ctx=>{
await ctx.client.query("SELECT set_config('crv.run_id',$1,true)",[String(ctx.runId)]);let n=0;
const docs=[{artist:41,key:'indecente-review',category:'discography',title:'Indecente — publicación musical por contrastar',content:'La Galería del Rock la presenta como Sencillo de 2011. El catálogo conserva una obra audiovisual con este título; se requiere distinguir una edición musical independiente antes de crear un disco. Se conserva la afirmación de la fuente y su evidencia.',url:indecente.evidencia.url,archive:indecente.evidencia.wayback,tags:['conflicto-documentado','publicacion-musical-por-contrastar'],metadata:{source:indecente}},
{artist:257,key:'lae-radio-2004',category:'playlist',title:'Los Andes Electrónicos — listas históricas de radio',content:'Listas históricas de difusión publicadas por Los Andes Electrónicos: 14 referencias fechadas el 24 de abril de 2004 y 16 de otra lista sin fecha explícita. Las menciones no equivalen a una edición discográfica ni establecen la nacionalidad de sus intérpretes.\n\n'+radio.map(r=>`${r.artista} — ${r.tema} ${r.sello}`).join('\n'),url:radio[0].url_origen,archive:'https://web.archive.org/web/'+radio[0].ts+'/'+radio[0].url_origen,tags:['lista-radio','difusion-historica'],metadata:{rows:radio}}];
for(const d of docs){const r=await ctx.client.query(`INSERT INTO media.artist_documents(artist_id,source_key,category,title,content,source_url,archive_url,tags,metadata) VALUES($1,$2,$3,$4,$5,$6,$7,$8,$9::jsonb) ON CONFLICT(artist_id,source_key) DO NOTHING`,[d.artist,TAG+':'+d.key,d.category,d.title,d.content,d.url,d.archive,[TAG,...d.tags],JSON.stringify(d.metadata)]);n+=r.rowCount??0;}return {documents:n,radioEntries:radio.length};
});writeFileSync(out+'/complementos.json',JSON.stringify(result,null,2));console.log(result);await closeDb();
