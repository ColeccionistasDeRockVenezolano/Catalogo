                <div class="theme-field theme-field--wide">
                  <label class="field-label" for="brand-donation-url"><%= t('admin.brandDonationUrl') %></label>
                  <input type="url" id="brand-donation-url" data-donation-field="url" maxlength="500" value="<%= branding.donation.url %>" placeholder="<%= t('admin.brandDonationUrlPlaceholder') %>">
