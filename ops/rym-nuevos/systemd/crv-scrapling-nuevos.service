[Unit]
Description=CRV «nuevos»: capturador RYM (Scrapling)
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/brian/apps/Coleccionistas De Rock Venezolano
ExecStart=/bin/bash "/home/brian/apps/Coleccionistas De Rock Venezolano/ops/rym-nuevos/capturador.sh"
Restart=on-failure
RestartSec=60
TimeoutStopSec=30


[Install]
