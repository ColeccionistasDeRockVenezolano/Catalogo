    <dialog class="modal modal--sm" id="admin-account-form" data-modal-root aria-labelledby="admin-account-title">
      <div class="modal__panel">
        <div class="modal__head">
          <div class="modal__titles">
            <span class="kicker"><%= t('admin.accountKicker') %></span>
            <h2 class="modal__title" id="admin-account-title"><%= t('admin.accountTitle') %><% if (currentAdmin) { %> (<%= currentAdmin.username %>)<% } %></h2>
          </div>
          <button type="button" class="modal__close" data-modal-close aria-label="<%= t('common.close') %>"><i data-lucide="x"></i></button>
        </div>
        <div class="modal__body">
          <form class="user-form" id="adminAccountForm">
            <div class="field">
              <label for="admin-current-password"><%= t('admin.accountCurrent') %></label>
